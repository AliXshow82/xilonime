[Unit]
Description=Xilonime API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/Xilonime/api
Environment=NODE_ENV=production
EnvironmentFile=/var/www/Xilonime/api/.env
ExecStart=/usr/bin/node /var/www/Xilonime/api/src/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
